  (text "\nR5: 0.8 V x (1 + 52.3/10) = 4.98 V\nR6: CHECK WEBENCH\nC5: CHECK WEBENCH\nC6: CHECK WEBENCH\nU2: EN tied to VIN\nL2: CHECK\nR8: 0.6 V x (1 + 100/22.1) = 3.31 V\nC10: feed-forward, CHECK\nR10: 32 V -> 2.42 V\nC15: safety-rated, 2 kV"
